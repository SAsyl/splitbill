# User service: systemctl --user. Starts at boot without login thanks to `loginctl enable-linger`.
[Unit]
Description=SplitBill: Telegram bot + Mini App
After=network-online.target

[Service]
WorkingDirectory=%h/D/Projects/splitbill
EnvironmentFile=%h/D/Projects/splitbill/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/D/Projects/splitbill/.venv/bin/python src/app.py
# No network yet at boot / Telegram unreachable -> exit and retry
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
